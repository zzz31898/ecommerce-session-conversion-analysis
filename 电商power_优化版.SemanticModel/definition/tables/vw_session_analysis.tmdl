table vw_session_analysis
	lineageTag: 1157dadf-c4f7-4463-b8e1-e6c1d01aa05e

	measure 会话数量 = COUNTROWS(vw_session_analysis)
		lineageTag: 489d1ae4-6770-4573-9f96-1862d01ad1eb

	measure 购买会话数 = SUM(vw_session_analysis[RevenueFlag])
		formatString: 0
		lineageTag: 592eb043-c9f1-43f6-ab5d-d5a97b732737

	measure 购买转化率 = DIVIDE([购买会话数], [会话数量])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b7f7ee2d-9786-42ef-b01a-1394f4dad219

	measure 平均产品页浏览量 =
			
			AVERAGE(vw_session_analysis[ProductRelated])
		formatString: 0.0
		lineageTag: b1a5212f-de08-41e6-aa5b-9c7e4bcc90dd

	measure 新访客会话数 =
			
			CALCULATE(
			    [会话数量],
			    vw_session_analysis[VisitorType] = "New_Visitor"
			)
		formatString: 0
		lineageTag: 645820fa-d7b8-4ccf-a1d8-da3729e07a08

	measure 新访客占比 =
			
			DIVIDE(
			    [新访客会话数],
			    [会话数量]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 32bf2c77-3b8d-4a96-8341-26b0f3dc6378

	measure 新访客转化率 =
			
			CALCULATE(
			    [购买转化率],
			    vw_session_analysis[VisitorType] = "New_Visitor"
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e9f3d492-5f3e-4826-9b5a-1d2fa69c5987

	measure 回访访客转化率 =
			
			CALCULATE(
			    [购买转化率],
			    vw_session_analysis[VisitorType] = "Returning_Visitor"
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d7b2f5a4-c7e8-450c-90e0-832eba7d4258

	measure 平均跳出率 =
			
			AVERAGE(vw_session_analysis[BounceRates])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4aaead57-28cb-4b0e-9ff5-3e96d3eb7002

	measure 平均退出率 =
			
			AVERAGE(vw_session_analysis[ExitRates])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 022aea50-4dbc-4ede-9471-53d199fbb489

	measure 平均产品页停留时长 =
			
			AVERAGE(
			    'vw_session_analysis'[ProductRelated_Duration]
			)
		lineageTag: 88e9b99d-b1b5-4d77-bd0e-a1f52a93d1a4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 产品页浏览量中位数 =
			
			MEDIAN(
			    'vw_session_analysis'[ProductRelated]
			)
		lineageTag: e357d88d-0924-447a-a669-82b5119d838e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 产品页停留时长中位数 =
			
			MEDIAN(
			    'vw_session_analysis'[ProductRelated_Duration]
			)
		lineageTag: 630c537a-a991-445a-90c7-17e0122e4360

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 平均管理页访问量 =
			
			AVERAGE(
			    'vw_session_analysis'[Administrative]
			)
		lineageTag: 36be44a6-dab1-45e0-a9de-71d89161e2e2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 平均信息页访问量 =
			
			AVERAGE(
			    'vw_session_analysis'[Informational]
			)
		lineageTag: 6b637dfe-e77c-47ce-8650-78091610da07

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '平均 PageValues' =
			
			AVERAGE(
			    'vw_session_analysis'[PageValues]
			)
		lineageTag: 3edb7687-92a3-4c22-a9cd-61817cdda9d8

		annotation PBI_FormatHint = {"isGeneralNumber":true}


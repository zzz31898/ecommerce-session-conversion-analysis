	column 日期类型 =
			
			IF(
			    LOWER(TRIM(vw_session_analysis[Weekend])) = "true",
			    "周末",
			    "工作日"
			)
		lineageTag: 52427653-7b3e-4b46-8c5b-c78605324fae
		summarizeBy: none
		sortByColumn: 日期类型排序

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 日期类型排序 =
			
			IF(
			    'vw_session_analysis'[Weekend],
			    2,
			    1
			)
		formatString: 0
		lineageTag: 22b7ebb8-5ad6-428f-bf9f-77fdf0e608e3
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 购买状态 =
			
			IF(
			    'vw_session_analysis'[RevenueFlag] = 1,
			    "购买",

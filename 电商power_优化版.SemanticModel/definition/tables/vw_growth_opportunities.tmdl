table vw_growth_opportunities
	lineageTag: 5c77928c-2119-4e2f-9f79-3094160d717f

	measure 未购买会话数 =
			
			DISTINCTCOUNT(
			    vw_growth_opportunities[SessionID]
			)
		formatString: #,0
		lineageTag: 568ed48c-ef4b-4f1f-beae-cf8325c53864

	measure 历史高潜未购买数 =
			
			CALCULATE(
			    [未购买会话数],
			    vw_growth_opportunities[OpportunityPriority] =
			        "P1 历史高潜未购买"
			)
		formatString: #,0
		lineageTag: e2264bbe-267a-40fd-9357-9d15f6f4ff4d

	measure 高浏览未购买数 =
			
			CALCULATE(
			    [未购买会话数],
			    vw_growth_opportunities[ProductRelated] >= 21
			)
		formatString: #,0
		lineageTag: b66fcba6-186a-470b-9c74-9137aa123d6e

	measure 回访未购买数 =
			
			CALCULATE(
			    [未购买会话数],
			    vw_growth_opportunities[VisitorType] =
			        "Returning_Visitor"
			)
		formatString: #,0
		lineageTag: c4b4a21f-12b8-4f66-a849-7fe182248514

	measure 平均行为倾向分数 =
			
			AVERAGE(
			    vw_growth_opportunities[BehaviorPropensityScore]
			)
		formatString: 0.00
		lineageTag: ae26f1ce-1b4e-4875-9e8b-9628c363611c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 历史高潜占比 =
			
			DIVIDE(
			    [历史高潜未购买数],
			    [未购买会话数]
			)
		lineageTag: 8dc0b21f-c0ef-4466-a0de-0f4cf2e6ad44

		annotation PBI_FormatHint = {"isGeneralNumber":true}


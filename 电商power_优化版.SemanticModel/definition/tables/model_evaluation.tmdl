table model_evaluation
	lineageTag: 57865fdd-3f60-4d96-8e60-38ad5ec41b94

	measure '行为模型 PR-AUC' =
			
			CALCULATE(
			    MAX('model_evaluation'[PRAUC]),
			    'model_evaluation'[Scenario] = "early_propensity"
			)
		formatString: 0.000
		lineageTag: b0fbc81b-4be5-476d-8b74-6a56a706c821

	measure '行为模型 ROC-AUC' =
			
